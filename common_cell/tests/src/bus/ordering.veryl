// Two AR requests are outstanding while a later write finishes first.
// The caller's tag must stay with its burst through both lanes and the stalled merge.
#[test(write_overtakes_two_ordered_reads)]
module BurstOrderingTest {
    alias package B = $std::axi4_pkg::<32, 4, 2, 1, 1, 1, 1, 1>;
    inst clk : $tb::clock_gen #( period: 10 );
    inst rst : $tb::reset_gen ( clk );
    inst axi : $std::axi4_if::<B>;
    inst port: common_cell::BurstPort::<B::ADDRESS_WIDTH, B::DATA_WIDTH_BYTES, 2, 4, 1>;
    inst dut: common_cell::AxiMemoryMaster::<B, 2, 4, 1> (
        clk                  ,
        rst_n           : rst,
        port                 ,
        axi                  ,
        read_attributes : '0 ,
        write_attributes: '0 ,
    );
    const WRITE_TAG: logic<4> = 3;
    initial {
        port.valid    = 0;
        port.accepted = 0;
        port.request  = '0;
        axi.arready   = 1;
        axi.rvalid    = 0;
        axi.rid       = 0;
        axi.rresp     = 0 as B::resp_t;
        axi.awready   = 1;
        axi.wready    = 1;
        axi.bvalid    = 0;
        axi.bid       = 0;
        axi.bresp     = 0 as B::resp_t;
        rst.assert();
        clk.next(3);
        port.valid          = 1;
        port.request.size   = 2;
        port.request.length = 1;
        for i in 0..2 {
            port.request.address = 32'h100 + i * 8;
            port.request.tag     = (9 + i) as 4;
            $assert(port.ready && axi.arvalid && axi.arid == 0 && axi.arlen == 1, "ORDERED_AR");
            clk.next();
        }
        port.request.write  = 1;
        port.request.tag    = WRITE_TAG;
        port.request.length = 0;
        $assert(port.ready, "WRITE_ADMITTED");
        clk.next();
        port.valid = 0;
        $assert(axi.awvalid && axi.awid == 0 && axi.wvalid && axi.wlast, "SINGLE_BEAT_WRITE");
        clk.next();
        axi.bvalid = 1;
        $assert(axi.bready, "WRITE_RESPONSE");
        clk.next();
        axi.bvalid = 0;
        clk.next(2);
        $assert(port.returned && port.receipt.tag == WRITE_TAG, "WRITE_PASSES_PENDING_READS");
        for i in 0..2 {
            for j in 0..2 {
                axi.rvalid = 1;
                axi.rdata  = 1 + i * 2 + j;
                axi.rlast  = j == 1;
                $assert(axi.rready, "READ_BEAT");
                clk.next();
            }
            axi.rvalid = 0;
            if i == 0 {
                $assert(port.returned && port.receipt.tag == WRITE_TAG, "STALLED_WRITE_RECEIPT_HELD");
                port.accepted = 1;
                clk.next();
                port.accepted = 0;
            }
            clk.next(2);
            $assert(port.returned && port.receipt.tag == 9 + i, "READ_RECEIPT_ORDER");
            $assert(port.receipt.data[31:0] == 1 + i * 2 && port.receipt.data[63:32] == 2 + i * 2, "BURST_DATA");
            $assert(!port.receipt.failed && !port.receipt.protocol_error, "RECEIPT_STATUS");
            port.accepted = 1;
            clk.next();
            port.accepted = 0;
        }
        clk.next(2);
        $assert(!port.returned, "NO_EXTRA_RECEIPT");
        $finish();
    }
}
