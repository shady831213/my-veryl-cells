// A client may assign its own USER encoding. Retryability covers every failing beat.
#[test(read_burst_response_policy)]
module ReadResponseTest {
    alias package B = $std::axi4_pkg::<32, 4, 2, 3, 1, 3, 3, 3>;
    inst clk : $tb::clock_gen #( period: 10 );
    inst rst : $tb::reset_gen ( clk );
    inst port: common_cell::BurstPort::<B::ADDRESS_WIDTH, B::DATA_WIDTH_BYTES, 2, 7, 3>;
    inst axi : $std::axi4_if::<B>;
    inst dut: common_cell::AxiMemoryMaster::<B, 2, 7, 3> (
        clk                                                                                                     ,
        rst_n           : rst                                                                                   ,
        port                                                                                                    ,
        axi                                                                                                     ,
        read_attributes : common_cell::AxiResponse::Attributes'{retryable: axi.ruser == 6, invalid: axi.ruser == 5},
        write_attributes: '0                                                                                    ,
    );
    initial {
        port.valid    = 0;
        port.accepted = 0;
        port.request  = '0;
        axi.arready   = 1;
        axi.awready   = 0;
        axi.wready    = 0;
        axi.bvalid    = 0;
        axi.rvalid    = 0;
        rst.assert();
        clk.next(3);
        for scenario in 0..5 {
            port.request.tag    = (64 + scenario) as 7;
            port.request.size   = 2;
            port.request.length = 1;
            port.valid          = 1;
            $assert(port.ready && axi.arvalid, "REQUEST_ACCEPTED");
            clk.next();
            port.valid = 0;
            for beat in 0..2 {
                axi.rvalid = 1;
                axi.rlast  = beat == 1;
                axi.rdata  = beat;
                axi.rid    = if scenario == 4 ? 1 : 0;
                axi.rresp  = (if scenario <: 3 ? 2 : 0) as B::resp_t;
                axi.ruser  = case scenario {
                    0      : 6,
                    1      : if beat == 0 ? 6 : 0,
                    2      : if beat == 1 ? 6 : 0,
                    3      : if beat == 0 ? 5 : 0,
                    default: 0,
                };
                $assert(axi.rready, "BEAT_ACCEPTED");
                clk.next();
            }
            axi.rvalid = 0;
            clk.next(4);
            $assert(port.returned && port.receipt.tag == port.request.tag, "TAG_HELD_UNDER_BACKPRESSURE");
            $assert(port.receipt.failed == (scenario <: 3), "BUS_ERROR");
            $assert(port.receipt.retryable == (scenario == 0), "ALL_ERRORS_RETRYABLE");
            $assert(port.receipt.protocol_error == (scenario >= 3), "USER_OR_ID_PROTOCOL_ERROR");
            port.accepted = 1;
            clk.next();
            port.accepted = 0;
        }
        $finish();
    }
}
