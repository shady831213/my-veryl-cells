// Independent ordered AXI lanes. Each accepted internal request owns one receipt;
// backpressure retains accepted transfers until their terminal responses.
pub module AxiMemoryMaster::<
    B          : $std::axi4_prototype = $std::axi4_pkg::<64, 8, 1, 1, 1, 1, 1, 1>,
    BURST_BEATS: u32                  = 8                  ,
    TAG_BITS   : u32                  = 8                  ,
    ATTR_BITS  : u32                  = 1                  ,
> #(
    param READ_OUTSTANDING : u32 = 8,
    param WRITE_OUTSTANDING: u32 = 8,
) (
    clk             : input   clock                  ,
    rst_n           : input   reset_async_low        ,
    read_attributes : input   AxiResponse::Attributes,
    write_attributes: input   AxiResponse::Attributes,
    port            : modport BurstPort::<
        B::ADDRESS_WIDTH   ,
        B::DATA_WIDTH_BYTES,
        BURST_BEATS        ,
        TAG_BITS           ,
        ATTR_BITS          ,
    >::slave,
    axi             : modport $std::axi4_if::<B>::master,
) {
    initial {
        if BURST_BEATS == 0 || BURST_BEATS >: 256 || READ_OUTSTANDING == 0 || WRITE_OUTSTANDING == 0 {
            $fatal(1, "Invalid AXI burst or outstanding capacity");
        }
        if B::DATA_WIDTH_BYTES <: 2 || B::DATA_WIDTH_BYTES >: 128 || (B::DATA_WIDTH_BYTES & (B::DATA_WIDTH_BYTES - 1))
            != 0 {
            $fatal(1, "Unsupported AXI data width");
        }
        if TAG_BITS == 0 || ATTR_BITS == 0 {
            $fatal(1, "Tag and attribute widths must be positive");
        }
    }
    alias package M = BurstMemory::<B::ADDRESS_WIDTH, B::DATA_WIDTH_BYTES, BURST_BEATS, TAG_BITS, ATTR_BITS>;
    inst reads : BurstPort::<B::ADDRESS_WIDTH, B::DATA_WIDTH_BYTES, BURST_BEATS, TAG_BITS, ATTR_BITS>;
    inst writes: BurstPort::<B::ADDRESS_WIDTH, B::DATA_WIDTH_BYTES, BURST_BEATS, TAG_BITS, ATTR_BITS>;
    inst lanes : $std::axi4_if::<B>;
    // A full interface joins disjoint read/write views. Passing the already
    // restricted master modport as a different modport is illegal SystemVerilog.
    connect axi            <> lanes.slave;
    assign reads.valid    = port.valid && !port.request.write;
    assign writes.valid   = port.valid && port.request.write;
    assign reads.request  = port.request;
    assign writes.request = port.request;
    assign port.ready     = if port.request.write ? writes.ready : reads.ready;
    inst reader: AxiMemoryRead::<B, BURST_BEATS, TAG_BITS, ATTR_BITS> #(
        OUTSTANDING: READ_OUTSTANDING,
    ) (
        clk                        ,
        rst_n                      ,
        attributes: read_attributes,
        port      : reads          ,
        axi       : lanes          ,
    );
    inst writer: AxiMemoryWrite::<B, BURST_BEATS, TAG_BITS, ATTR_BITS> #(
        OUTSTANDING: WRITE_OUTSTANDING,
    ) (
        clk                         ,
        rst_n                       ,
        attributes: write_attributes,
        port      : writes          ,
        axi       : lanes           ,
    );
    var cursor  : logic   ;
    var selected: logic<2>;
    var ready   : logic   ;
    assign selected        = RoundRobin::<2>::select({writes.returned, reads.returned}, cursor);
    assign reads.accepted  = selected[0] && ready;
    assign writes.accepted = selected[1] && ready;
    // Register the merged receipt; a newly arriving contender cannot replace a
    // receipt already offered under downstream backpressure.
    inst result: ReadyValidSlice #(
        TYPE: M::Receipt                                 ,
        MODE: ReadyValid::SliceMode::Forward,
    ) (
        clk                                                      ,
        rst_n                                                    ,
        s_valid : |selected                                      ,
        s_ready : ready                                          ,
        s_data  : if selected[1] ? writes.receipt : reads.receipt,
        m_valid : port.returned                                  ,
        m_ready : port.accepted                                  ,
        m_data  : port.receipt                                   ,
        occupied: _                                              ,
    );
    always_ff (clk, rst_n) {
        if_reset {
            cursor = 0;
        } else if ready && |selected {
            cursor = selected[0];
        }
    }
}
