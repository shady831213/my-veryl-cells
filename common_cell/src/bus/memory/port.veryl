// One accepted bounded transfer produces one terminal receipt with the caller's tag.
// Payload bytes are packed densely, size is log2(bytes per beat), length is beats minus one.
pub package BurstMemory::<
    ADDRESS_BITS: u32 = 64,
    DATA_BYTES  : u32 = 8 ,
    BURST_BEATS : u32 = 8 ,
    TAG_BITS    : u32 = 8 ,
    ATTR_BITS   : u32 = 1 ,
> {
    const DATA_BITS  : u32 = DATA_BYTES * 8;
    const DATA_SIZE  : u32 = $clog2(DATA_BYTES);
    const BURST_BITS : u32 = DATA_BITS * BURST_BEATS;
    const LENGTH_BITS: u32 = if BURST_BEATS >: 1 ? $clog2(BURST_BEATS) : 1;
    struct Request {
        tag       : logic<TAG_BITS>    ,
        write     : logic              ,
        address   : logic<ADDRESS_BITS>,
        attributes: logic<ATTR_BITS>   ,
        size      : logic<3>           ,
        length    : logic<LENGTH_BITS> ,
        data      : logic<BURST_BITS>  ,
    }
    struct Receipt {
        tag           : logic<TAG_BITS>  ,
        data          : logic<BURST_BITS>,
        failed        : logic            ,
        retryable     : logic            ,
        protocol_error: logic            ,
    }
}

pub interface BurstPort::<
    ADDRESS_BITS: u32 = 64,
    DATA_BYTES  : u32 = 8 ,
    BURST_BEATS : u32 = 8 ,
    TAG_BITS    : u32 = 8 ,
    ATTR_BITS   : u32 = 1 ,
> {
    alias package M = BurstMemory::<ADDRESS_BITS, DATA_BYTES, BURST_BEATS, TAG_BITS, ATTR_BITS>;
    var valid   : logic     ;
    var ready   : logic     ;
    var request : M::Request;
    var returned: logic     ;
    var accepted: logic     ;
    var receipt : M::Receipt;
    modport master {
        valid   : output,
        ready   : input ,
        request : output,
        returned: input ,
        accepted: output,
        receipt : input ,
    }
    modport slave {
        ..converse(master)
    }
}
